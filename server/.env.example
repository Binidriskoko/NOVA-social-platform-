PORT=4000
HOST=0.0.0.0
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nova?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
COOKIE_NAME="nova_session"
COOKIE_SAME_SITE="lax"
CORS_ORIGIN="http://localhost:5173"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=20
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
REGISTRATION_DATA_ENCRYPTION_KEY="replace-with-a-distinct-random-32-character-or-longer-key"
ADMIN_NAME="NOVA Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-local-password"
MODERATOR_NAME="NOVA Moderator"
MODERATOR_EMAIL="moderator@example.com"
MODERATOR_PASSWORD="replace-with-a-strong-local-password"
