generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
  SUPPORT
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DEACTIVATED
}

enum ReactionType {
  LIKE
  LOVE
  LAUGH
  SAD
  ANGRY
}

enum PostVisibility {
  PUBLIC
  FOLLOWERS
  PRIVATE
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
  DELETED
}

enum ReportCategory {
  SPAM
  HARASSMENT
  SEXUAL_CONTENT
  HATE
  VIOLENCE
  SCAM
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  REJECTED
}

enum CommunityMemberRole {
  MEMBER
  MODERATOR
  OWNER
}

enum CreatorSubscriptionStatus {
  PENDING
  ACTIVE
  CANCELLED
  EXPIRED
}

enum BusinessVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum BusinessTeamRole {
  OWNER
  ADMIN
  EDITOR
  ANALYST
}

enum MarketplaceProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  OUT_OF_STOCK
}

enum MarketplaceOrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  DISPUTED
}

enum MarketplaceDisputeStatus {
  OPEN
  REVIEWING
  RESOLVED
  REJECTED
}

model User {
  id                       String     @id @default(cuid())
  email                    String?    @unique
  phoneE164                String?    @unique
  phoneVerifiedAt          DateTime?
  name                     String
  passwordHash             String
  role                     UserRole   @default(USER)
  status                   UserStatus @default(ACTIVE)
  communityRulesAccepted   Boolean    @default(false)
  communityRulesAcceptedAt DateTime?
  rulesVersion             String?
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  profile                  Profile?
  privateDetails           PrivateProfile?
  mfaMethods               MfaMethod[]
  securityAlerts           SecurityAlert[]
  sessions                 Session[]
  posts                    Post[]
  postSaves                PostSave[]
  postShares               PostShare[]
  comments                 Comment[]
  reactions                Reaction[]
  followsGiven             Follow[]                  @relation("Follower")
  followsReceived          Follow[]                  @relation("Following")
  blocksGiven              Block[]                   @relation("Blocker")
  blocksReceived           Block[]                   @relation("Blocked")
  reportsMade              Report[]                  @relation("Reporter")
  reportsAbout             Report[]                  @relation("ReportedUser")
  notifications            Notification[]            @relation("NotificationRecipient")
  notificationPreferences  NotificationPreference[]
  authoredStories          Story[]                    @relation("StoryAuthor")
  storyViews               StoryView[]                @relation("StoryViewer")
  conversationsOwnedBy     Conversation[]            @relation("ConversationOwner")
  messageSent              Message[]                 @relation("MessageSender")
  messageReactions         MessageReaction[]
  conversationParticipants ConversationParticipant[]
  subscriptions            Subscription[]
  entitlements             Entitlement[]
  communityMemberships     CommunityMember[]
  ownedCommunities         Community[]
  adminActions             AdminAction[]             @relation("AdminActionActor")
  actionTargets            AdminAction[]             @relation("AdminActionTarget")
  creatorProfile           CreatorProfile?
  creatorApplications      CreatorApplication[]       @relation("CreatorApplicant")
  reviewedCreatorApplications CreatorApplication[]    @relation("CreatorApplicationReviewer")
  videoMeasurements        VideoMeasurement[]
  adCampaigns              AdCampaign[]                @relation("AdCampaignAdvertiser")
  reviewedAdCampaigns      AdCampaign[]                @relation("AdCampaignReviewer")
  adEvents                 AdEvent[]
  adConsent                AdConsent?
  creatorSubscriptions     CreatorSubscription[]     @relation("CreatorSubscriber")
  businessOwned            BusinessProfile?          @relation("BusinessOwner")
  businessMemberships      BusinessMember[]
  businessFollows          BusinessFollower[]
  businessPosts            BusinessPost[]
  sellerProfile            SellerProfile?
  marketplaceOrders        MarketplaceOrder[]        @relation("OrderBuyer")
  productInquiries         ProductInquiry[]          @relation("InquiryBuyer")
  marketplaceDisputes      MarketplaceDispute[]      @relation("DisputeReporter")
  financialPaymentIntents  PaymentIntent[]           @relation("PaymentPayer")
  uploadedMedia            RegistrationMediaObject[]

  @@index([email])
  @@index([phoneE164])
  @@index([role])
  @@index([status])
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String?
  username    String?  @unique
  bio         String?
  avatarUrl   String?
  coverUrl    String?
  location    String?
  website     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PrivateProfile {
  id                String    @id @default(cuid())
  userId            String    @unique
  dateOfBirth       DateTime?
  countryCode       String?
  region            String?
  city              String?
  addressCiphertext String?
  addressIv         String?
  addressTag        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MfaMethod {
  id         String    @id @default(cuid())
  userId     String
  type       String
  secretHash String?
  enabledAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, enabledAt])
}

model SecurityAlert {
  id        String    @id @default(cuid())
  userId    String
  type      String
  details   String?
  createdAt DateTime  @default(now())
  readAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  userAgent  String?
  deviceName String?
  ipAddress  String?
  lastSeenAt DateTime?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Post {
  id          String         @id @default(cuid())
  authorId    String
  communityId String?
  content     String
  imageUrl    String?
  visibility  PostVisibility @default(PUBLIC)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  community Community?  @relation(fields: [communityId], references: [id], onDelete: SetNull)
  comments  Comment[]
  reactions Reaction[]
  videoMeasurements VideoMeasurement[]
  reports   Report[]
  saves     PostSave[]
  shares    PostShare[]

  @@index([authorId])
  @@index([communityId])
  @@index([createdAt])
}

model VideoMeasurement {
  id             String   @id @default(cuid())
  postId         String
  viewerId       String
  sessionId      String
  source         String   @default("unknown")
  watchSeconds   Int
  durationSeconds Int
  lastPositionSeconds Int @default(0)
  lastHeartbeatAt DateTime?
  active         Boolean  @default(true)
  startedAt      DateTime
  endedAt        DateTime
  qualified      Boolean  @default(false)
  createdAt      DateTime @default(now())

  post  Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  viewer User @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([postId, viewerId, sessionId])
  @@index([postId, createdAt])
  @@index([viewerId, createdAt])
  @@index([qualified, createdAt])
}

model Story {
  id        String   @id @default(cuid())
  authorId  String
  kind      String   @default("STORY")
  text      String?
  mediaUrl  String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  author User        @relation("StoryAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  views  StoryView[]

  @@index([authorId, createdAt])
  @@index([expiresAt])
}

model StoryView {
  id       String   @id @default(cuid())
  storyId  String
  viewerId String
  viewedAt DateTime @default(now())

  story  Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer User  @relation("StoryViewer", fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([storyId, viewerId])
  @@index([viewerId])
}

model PostSave {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
}

model PostShare {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([userId, createdAt])
}

model Conversation {
  id                       String    @id @default(cuid())
  name                     String?
  description              String?
  imageUrl                 String?
  isChannel                Boolean   @default(false)
  isGroup                  Boolean   @default(false)
  disappearingAfterSeconds Int       @default(0)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  lastMessageAt            DateTime?
  lastMessagePreview       String?
  ownerId                  String?

  owner        User?                     @relation("ConversationOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([ownerId])
  @@index([updatedAt])
}

model ConversationParticipant {
  id             String              @id @default(cuid())
  conversationId String
  userId         String
  role           CommunityMemberRole @default(MEMBER)
  joinedAt       DateTime            @default(now())
  lastReadAt     DateTime?
  leftAt         DateTime?
  pinnedAt       DateTime?
  archivedAt     DateTime?
  starredAt      DateTime?
  mutedUntil     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
}

model Message {
  id              String        @id @default(cuid())
  conversationId  String
  senderId        String
  text            String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  readAt          DateTime?
  deletedAt       DateTime?
  status          MessageStatus @default(SENT)
  contentType     String        @default("TEXT")
  mediaUrl        String?
  metadata        Json?
  replyToId       String?
  forwardedFromId String?
  editedAt        DateTime?
  expiresAt       DateTime?

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User              @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  reactions    MessageReaction[]

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([readAt])
  @@index([status])
  @@index([expiresAt])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  type      String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, type])
  @@index([messageId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  parentId  String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post      Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Comment?   @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies   Comment[]  @relation("CommentReplies")
  reactions Reaction[]
  reports   Report[]

  @@index([postId])
  @@index([authorId])
  @@index([parentId])
}

model Reaction {
  id        String       @id @default(cuid())
  userId    String
  postId    String?
  commentId String?
  type      ReactionType
  createdAt DateTime     @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, postId, type])
  @@unique([userId, commentId, type])
  @@index([postId])
  @@index([commentId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model Report {
  id           String         @id @default(cuid())
  reporterId   String
  postId       String?
  commentId    String?
  targetUserId String?
  category     ReportCategory
  details      String?
  status       ReportStatus   @default(OPEN)
  createdAt    DateTime       @default(now())
  resolvedAt   DateTime?

  reporter   User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  post       Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment    Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  targetUser User?    @relation("ReportedUser", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([reporterId])
  @@index([postId])
  @@index([commentId])
  @@index([targetUserId])
  @@index([status])
}

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String
  key       String
  enabled   Boolean  @default(true)
  channel   String   @default("in_app")
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
}

model Notification {
  id          String    @id @default(cuid())
  recipientId String
  actorId     String?
  type        String
  message     String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  recipient User @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt])
  @@index([createdAt])
}

model SubscriptionPlan {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  priceCents  Int
  currency    String   @default("USD")
  interval    String   @default("month")
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]

  @@index([isActive])
}

model Subscription {
  id                 String    @id @default(cuid())
  userId             String
  planId             String
  status             String    @default("ACTIVE")
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  plan     SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([userId, status])
  @@index([planId])
}

model Payment {
  id                String   @id @default(cuid())
  subscriptionId    String
  userId            String
  provider          String   @default("local")
  providerReference String?
  amountCents       Int
  currency          String   @default("USD")
  status            String   @default("PENDING")
  createdAt         DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([userId])
}

model PaymentWebhookEvent {
  id              String    @id @default(cuid())
  provider        String
  providerEventId String
  payloadHash     String
  status          String    @default("RECEIVED")
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?
  errorMessage    String?

  @@unique([provider, providerEventId])
  @@index([status])
  @@index([receivedAt])
}

model Entitlement {
  id        String   @id @default(cuid())
  userId    String
  key       String
  value     String?
  source    String   @default("subscription")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
}

model Community {
  id          String        @id @default(cuid())
  ownerId     String
  name        String
  slug        String        @unique
  description String?
  avatarUrl   String?
  type        CommunityType @default(COMMUNITY)
  isPrivate   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  owner   User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members CommunityMember[]
  posts   Post[]

  @@index([ownerId])
  @@index([name])
}

enum CommunityType {
  GROUP
  COMMUNITY
  CHANNEL
}

model CommunityMember {
  id          String              @id @default(cuid())
  communityId String
  userId      String
  role        CommunityMemberRole @default(MEMBER)
  joinedAt    DateTime            @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([communityId])
  @@index([userId])
}

model AdminAction {
  id           String   @id @default(cuid())
  actorId      String
  targetUserId String?
  actionType   String
  details      String?
  createdAt    DateTime @default(now())

  actor      User  @relation("AdminActionActor", fields: [actorId], references: [id], onDelete: Cascade)
  targetUser User? @relation("AdminActionTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([targetUserId])
  @@index([actionType])
}

model CreatorProfile {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  headline               String?
  category               String?
  subscriptionPriceCents Int      @default(0)
  currency               String   @default("USD")
  isEnabled              Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscribers   CreatorSubscription[]
  ledgerEntries CreatorLedgerEntry[]
  payouts       CreatorPayoutRequest[]

  @@index([isEnabled])
}

model MonetizationSettings {
  id                      String   @id @default("default")
  enabled                 Boolean  @default(false)
  minimumFollowers        Int      @default(1000)
  minimumQualifiedViews   Int      @default(0)
  qualifiedViewWindowDays Int      @default(30)
  minimumWatchTimeSeconds Int      @default(0)
  minimumEngagementRate   Float    @default(0)
  minimumAccountAgeDays   Int      @default(30)
  minimumPublicPosts      Int      @default(0)
  revenueSharePercent     Int      @default(90)
  minimumPayoutCents      Int      @default(0)
  updatedBy               String?
  updatedAt               DateTime @updatedAt
}

model CreatorApplication {
  id                String   @id @default(cuid())
  creatorId         String
  status            String   @default("PENDING")
  reason            String?
  reviewNote        String?
  reviewedBy        String?
  reviewedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  creator  User  @relation("CreatorApplicant", fields: [creatorId], references: [id], onDelete: Cascade)
  reviewer User? @relation("CreatorApplicationReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([creatorId, createdAt])
  @@index([status, createdAt])
}

model AdNetworkSettings {
  id        String   @id @default("default")
  enabled   Boolean  @default(false)
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model AdConsent {
  id          String    @id @default(cuid())
  userId      String    @unique
  consentedAt DateTime?
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdPlacement {
  id          String   @id @default(cuid())
  key         String   @unique
  enabled     Boolean  @default(false)
  dailyBudgetCents Int @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaigns AdCampaign[]
}

model AdCampaign {
  id                       String   @id @default(cuid())
  advertiserId             String
  placementId              String
  name                     String
  creativeUrl              String
  destinationUrl           String
  status                   String   @default("DRAFT")
  startsAt                 DateTime
  endsAt                   DateTime
  totalBudgetCents         Int
  dailyBudgetCents         Int
  costPerImpressionCents   Int      @default(0)
  costPerClickCents        Int      @default(0)
  spendCents               Int      @default(0)
  reviewNote               String?
  reviewedBy               String?
  reviewedAt               DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  advertiser User         @relation("AdCampaignAdvertiser", fields: [advertiserId], references: [id], onDelete: Cascade)
  reviewer   User?        @relation("AdCampaignReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  placement  AdPlacement  @relation(fields: [placementId], references: [id], onDelete: Restrict)
  events     AdEvent[]

  @@index([status, startsAt, endsAt])
  @@index([advertiserId, createdAt])
  @@index([placementId, status])
}

model AdEvent {
  id           String   @id @default(cuid())
  campaignId   String
  viewerId     String
  eventType    String
  dayKey       String
  eventKey     String   @unique
  amountCents  Int      @default(0)
  createdAt    DateTime @default(now())

  campaign AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  viewer   User       @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([campaignId, viewerId, eventType, dayKey])
  @@index([campaignId, eventType, createdAt])
}

model CreatorSubscription {
  id                String                    @id @default(cuid())
  creatorId         String
  subscriberId      String
  status            CreatorSubscriptionStatus @default(ACTIVE)
  provider          String                    @default("manual")
  providerReference String?
  amountCents       Int
  currency          String                    @default("USD")
  startedAt         DateTime                  @default(now())
  endsAt            DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  subscriber User           @relation("CreatorSubscriber", fields: [subscriberId], references: [id], onDelete: Cascade)
  profile    CreatorProfile @relation(fields: [creatorId], references: [userId], onDelete: Cascade)

  @@unique([creatorId, subscriberId])
  @@index([creatorId, status])
  @@index([subscriberId, status])
}

model CreatorLedgerEntry {
  id          String   @id @default(cuid())
  creatorId   String
  type        String
  amountCents Int
  currency    String   @default("USD")
  reference   String?
  description String?
  createdAt   DateTime @default(now())

  profile CreatorProfile @relation(fields: [creatorId], references: [userId], onDelete: Cascade)

  @@index([creatorId, createdAt])
  @@index([reference])
}

model CreatorPayoutRequest {
  id                String   @id @default(cuid())
  creatorId         String
  idempotencyKey    String?
  amountCents       Int
  currency          String   @default("USD")
  status            String   @default("PENDING")
  provider          String   @default("manual")
  providerReference String?
  requestedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt

  profile CreatorProfile @relation(fields: [creatorId], references: [userId], onDelete: Cascade)

  @@unique([creatorId, idempotencyKey])
  @@index([creatorId, status])
}

model BusinessProfile {
  id                 String                     @id @default(cuid())
  ownerId            String                     @unique
  name               String
  category           String
  description        String?
  contactEmail       String?
  contactPhone       String?
  website            String?
  verificationStatus BusinessVerificationStatus @default(UNVERIFIED)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  owner     User               @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members   BusinessMember[]
  followers BusinessFollower[]
  posts     BusinessPost[]

  @@index([category])
  @@index([verificationStatus])
}

model BusinessMember {
  id         String           @id @default(cuid())
  businessId String
  userId     String
  role       BusinessTeamRole @default(EDITOR)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  business BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
}

model BusinessFollower {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  createdAt  DateTime @default(now())

  business BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
}

model BusinessPost {
  id         String   @id @default(cuid())
  businessId String
  authorId   String
  content    String
  imageUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  author   User            @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
}

model SellerProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  displayName  String
  description  String?
  contactEmail String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  products MarketplaceProduct[]

  @@index([displayName])
}

model MarketplaceProduct {
  id          String                   @id @default(cuid())
  sellerId    String
  title       String
  description String
  category    String
  priceCents  Int
  currency    String                   @default("USD")
  stock       Int                      @default(0)
  status      MarketplaceProductStatus @default(DRAFT)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  seller    SellerProfile          @relation(fields: [sellerId], references: [userId], onDelete: Cascade)
  images    ProductImage[]
  items     MarketplaceOrderItem[]
  inquiries ProductInquiry[]

  @@index([sellerId, status])
  @@index([category, status])
  @@index([title])
}

model ProductImage {
  id         String   @id @default(cuid())
  productId  String
  url        String
  storageKey String?
  altText    String?
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  product MarketplaceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model MarketplaceOrder {
  id            String                 @id @default(cuid())
  buyerId       String
  status        MarketplaceOrderStatus @default(PENDING)
  paymentStatus String                 @default("UNPAID")
  totalCents    Int
  currency      String                 @default("USD")
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  cancelledAt   DateTime?

  buyer     User                   @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  items     MarketplaceOrderItem[]
  disputes  MarketplaceDispute[]
  inquiries ProductInquiry[]

  @@index([buyerId, createdAt])
  @@index([status, createdAt])
}

model MarketplaceOrderItem {
  id             String @id @default(cuid())
  orderId        String
  productId      String
  sellerId       String
  titleSnapshot  String
  quantity       Int
  unitPriceCents Int
  currency       String

  order   MarketplaceOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product MarketplaceProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([sellerId, orderId])
  @@index([productId])
}

model ProductInquiry {
  id        String   @id @default(cuid())
  productId String
  buyerId   String
  message   String
  orderId   String?
  createdAt DateTime @default(now())

  product MarketplaceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyer   User               @relation("InquiryBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  order   MarketplaceOrder?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([buyerId])
}

model MarketplaceDispute {
  id         String                   @id @default(cuid())
  orderId    String
  reporterId String
  reason     String
  status     MarketplaceDisputeStatus @default(OPEN)
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt

  order    MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reporter User             @relation("DisputeReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
  @@index([reporterId])
}

model PaymentIntent {
  id                String   @id @default(cuid())
  reference         String   @unique
  idempotencyKey    String
  payerId           String
  provider          String
  providerReference String?  @unique
  amountCents       Int
  currency          String
  purpose           String
  targetId          String?
  status            String   @default("PENDING")
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  payer User @relation("PaymentPayer", fields: [payerId], references: [id], onDelete: Restrict)

  @@unique([payerId, idempotencyKey])
  @@index([payerId, createdAt])
  @@index([purpose, targetId])
  @@index([status, createdAt])
}

model FinancialWebhookEvent {
  id               String    @id @default(cuid())
  provider         String
  providerEventId  String
  paymentReference String
  payloadHash      String
  status           String    @default("RECEIVED")
  receivedAt       DateTime  @default(now())
  processedAt      DateTime?

  @@unique([provider, providerEventId])
  @@index([paymentReference, receivedAt])
}

model FinancialLedgerEntry {
  id             String   @id @default(cuid())
  ownerId        String
  direction      String
  type           String
  amountCents    Int
  currency       String
  sourceType     String
  sourceId       String
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  @@index([ownerId, createdAt])
  @@index([sourceType, sourceId])
}

model FinancialRefund {
  id               String    @id @default(cuid())
  paymentReference String
  requestorId      String
  reference        String    @unique
  amountCents      Int
  currency         String
  reason           String
  status           String    @default("PENDING")
  reviewedBy       String?
  reviewedAt       DateTime?
  reviewReason     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([paymentReference, requestorId])
  @@index([status, createdAt])
}

model FinancialDispute {
  id                String   @id @default(cuid())
  paymentReference  String
  reporterId        String
  status            String   @default("OPEN")
  reason            String
  notes             String?
  evidenceReference String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([paymentReference, status])
  @@index([reporterId, createdAt])
}

model RegistrationMediaObject {
  id          String   @id @default(cuid())
  key         String   @unique
  bytes       Bytes
  contentType String
  ownerUserId String?
  createdAt   DateTime @default(now())

  owner User? @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([ownerUserId])
}
